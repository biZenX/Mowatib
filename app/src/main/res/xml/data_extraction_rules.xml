<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="mowatib_tasks_prefs.xml"/>
        <include domain="sharedpref" path="mowatib_habits_prefs.xml"/>
        <include domain="sharedpref" path="mowatib_telegram_prefs.xml"/>
        <include domain="sharedpref" path="mowatib_sync_prefs.xml"/>
        <include domain="file" path="datastore/settings.preferences_pb"/>
        <include domain="file" path="datastore/runtime_state.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="mowatib_tasks_prefs.xml"/>
        <include domain="sharedpref" path="mowatib_habits_prefs.xml"/>
        <include domain="sharedpref" path="mowatib_telegram_prefs.xml"/>
        <include domain="sharedpref" path="mowatib_sync_prefs.xml"/>
        <include domain="database" path="zenith_database"/>
        <include domain="file" path="datastore/settings.preferences_pb"/>
        <include domain="file" path="datastore/runtime_state.preferences_pb"/>
        <exclude domain="database" path="zenith_database-wal"/>
        <exclude domain="database" path="zenith_database-shm"/>
    </device-transfer>
</data-extraction-rules>
